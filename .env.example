# Database Connection (Neon PostgreSQL or Local Docker Postgres)
# Local Docker Postgres example: postgresql://postgres:postgres@localhost:5432/student_management?sslmode=disable
# Neon / Remote Postgres example: postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/student_management?sslmode=disable"

